# Même produit chez Amazon pour chaque fiche notée au moins 55 (API Creators, décision du propriétaire du 2026-11-28).
[Unit]
Description=Toutou Gourmet - offres Amazon des fiches
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=toutou
WorkingDirectory=/srv/toutou/current
EnvironmentFile=/srv/toutou/shared/.env
Nice=15
TimeoutStartSec=5h
# Verrou commun à tous les scripts Amazon (Toutou et QRT) : 1 requête par seconde pour tout le compte.
ExecStart=/usr/bin/flock -w 3600 /run/lock/amazon-api.lock /srv/toutou/current/node_modules/.bin/tsx scripts/amazon-offres.ts --limite=2000
