# /etc/caddy/Caddyfile — à activer seulement le jour de la bascule DNS.
# Caddy obtient et renouvelle seul les certificats HTTPS dès que le DNS pointe ici.

toutou-gourmet.com {
	redir https://www.toutou-gourmet.com{uri} permanent
}

www.toutou-gourmet.com {
	encode zstd gzip
	log {
		output stderr
		format json
	}
	# Le tableau de bord ne se sert que sur dashboard.toutou-gourmet.com.
	@admin path /tableau-de-bord /tableau-de-bord/*
	respond @admin 404
	reverse_proxy 127.0.0.1:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Tableau de bord privé : la page /tableau-de-bord du site, protégée par DASHBOARD_USER /
# DASHBOARD_PASSWORD (authentification faite par l'application, pas par Caddy).
dashboard.toutou-gourmet.com {
	encode zstd gzip
	log {
		output stderr
		format json
	}
	# Ne sert que le tableau de bord et ses ressources ; tout le reste renvoie vers lui.
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	@allowed path /tableau-de-bord /tableau-de-bord/* /_next/* /images/* /icon.svg /favicon.ico
	handle @allowed {
		reverse_proxy 127.0.0.1:3000
	}
	handle {
		redir * /tableau-de-bord
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# Sites hébergés sur le VPS (deploy/sites)
# --- 10minlanguages.com (deploy/sites, port 3101) ---
