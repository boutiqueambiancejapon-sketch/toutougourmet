# /etc/caddy/Caddyfile — à activer seulement le jour de la bascule DNS.
# Caddy obtient et renouvelle seul les certificats HTTPS dès que le DNS pointe ici.

toutou-gourmet.com {
	redir https://www.toutou-gourmet.com{uri} permanent
}

www.toutou-gourmet.com {
	encode zstd gzip
	log {
		output stderr
		format json
	}
	reverse_proxy 127.0.0.1:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Tableau de bord privé : la page /tableau-de-bord du site, protégée par DASHBOARD_USER /
# DASHBOARD_PASSWORD (authentification faite par l'application, pas par Caddy).
dashboard.toutou-gourmet.com {
	encode zstd gzip
	log {
		output stderr
		format json
	}
	@root path /
	redir @root /tableau-de-bord
	reverse_proxy 127.0.0.1:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
