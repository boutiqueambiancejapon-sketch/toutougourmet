# Safeguard : réglages des builds, lus par vps-build à chaque lancement.
# Bornes imposées par vps-build quoi qu'il y ait ici : mémoire max 3 à 7 Go, freinage 2 Go à max,
# délai 300 à 7200 s, attente 60 à 14400 s. L'agent Safeguard peut les ajuster dans ces bornes.
BUILD_MEMORY_MAX_GB=5
BUILD_MEMORY_HIGH_GB=4
BUILD_TIMEOUT=3600
BUILD_WAIT_MAX=5400
