# Safeguard : réglages des builds, lus par vps-build à chaque lancement.
# Bornes imposées par vps-build quoi qu'il y ait ici : mémoire max 4 à 10 Go, freinage 3 Go à max,
# délai 300 à 7200 s, attente 60 à 14400 s. L'agent Safeguard peut les ajuster dans ces bornes.
# 2026-11-21 : 4/5 Go freinait le build de Toutou (8 workers) au point de le faire échouer (pages > 60 s).
BUILD_MEMORY_MAX_GB=9
BUILD_MEMORY_HIGH_GB=7
BUILD_TIMEOUT=3600
BUILD_WAIT_MAX=5400
