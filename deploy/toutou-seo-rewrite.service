# Contenu quotidien sur la branche v2 : 1 nouvel article + 2 réécritures (deploy/seo-rewrite.sh).
[Unit]
Description=Toutou Gourmet : 1 nouvel article + 2 réécritures SEO (v2)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=administrator
Environment=HOME=/home/administrator
Environment=LANG=C.UTF-8
ExecStart=/home/administrator/Toutou/deploy/seo-rewrite.sh
TimeoutStartSec=3h
