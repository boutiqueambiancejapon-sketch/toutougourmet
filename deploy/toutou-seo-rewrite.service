# Contenu de nuit sur la branche v2 : réécritures (deploy/seo-rewrite.sh). Les nouveaux articles : toutou-article-*.
[Unit]
Description=Toutou Gourmet : réécritures SEO (v2)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=administrator
Environment=HOME=/home/administrator
Environment=LANG=C.UTF-8
ExecStart=/home/administrator/Toutou/deploy/seo-rewrite.sh
TimeoutStartSec=3h
